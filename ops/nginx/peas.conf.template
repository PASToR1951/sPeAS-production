# PeAS native-production nginx template.
# Replace every {{TOKEN}} before installation, validate with `nginx -t`, then
# reload nginx. The PeAS application port must be firewalled so only this proxy
# and approved monitoring sources can reach it.

limit_req_zone $binary_remote_addr zone=peas_general:10m rate=300r/m;
limit_req_zone $binary_remote_addr zone=peas_download:10m rate=60r/m;
limit_req_zone $binary_remote_addr zone=peas_mutation:10m rate=30r/m;
limit_conn_zone $binary_remote_addr zone=peas_download_connections:10m;
limit_req_status 429;
limit_conn_status 429;

upstream peas_native_app {
    server {{PEAS_APP_PRIVATE_ADDRESS}};
    keepalive 32;
}

server {
    listen 80;
    listen [::]:80;
    server_name {{PEAS_PUBLIC_HOSTNAME}};
    return 301 https://$server_name$request_uri;
}

server {
    listen 443 ssl;
    listen [::]:443 ssl;
    http2 on;
    server_name {{PEAS_PUBLIC_HOSTNAME}};

    ssl_certificate {{TLS_CERTIFICATE_PATH}};
    ssl_certificate_key {{TLS_PRIVATE_KEY_PATH}};
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:PEAS_TLS:10m;
    ssl_session_timeout 1d;
    ssl_session_tickets off;
    server_tokens off;

    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;
    client_max_body_size 100m;

    if ($request_method = TRACE) {
        return 405;
    }

    location ~ ^/api/public/(documents/[0-9]+/download|compiled-documents/[0-9]+/foreword/download)$ {
        limit_req zone=peas_download burst=20 nodelay;
        limit_conn peas_download_connections 4;
        proxy_pass http://peas_native_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location ~ ^/api/(auth/|contact-inquiries$|newsletter/|security/csp-report$) {
        limit_req zone=peas_mutation burst=10 nodelay;
        proxy_pass http://peas_native_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location /api/ {
        limit_req zone=peas_general burst=100 nodelay;
        proxy_pass http://peas_native_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }

    location / {
        proxy_pass http://peas_native_app;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Forwarded "";
        proxy_set_header Connection "";
        proxy_read_timeout 300s;
        proxy_send_timeout 300s;
    }
}
