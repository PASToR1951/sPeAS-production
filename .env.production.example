# Copy this file to /etc/peas/peas.env on the server and keep it mode 0600.
# The deployment script creates the secret files referenced below.

PUBLIC_APP_URL=https://archive.example.edu
BETTER_AUTH_URL=https://archive.example.edu
ACME_EMAIL=operations@example.edu
AUTH_ALLOWED_EMAIL_DOMAIN=spud.edu.ph

# These image values must be immutable tags or digests selected by peas-deploy.
PEAS_IMAGE=ghcr.io/example/speas-production@sha256:replace-me
PEAS_POSTGRES_IMAGE=postgres:17-alpine@sha256:replace-me
PEAS_CADDY_IMAGE=caddy:2-alpine@sha256:replace-me
PEAS_CLAMAV_IMAGE=clamav/clamav:stable@sha256:replace-me
PEAS_RELEASE_ID=replace-with-release-tag
PEAS_SECRETS_DIR=/etc/peas/secrets

SMTP_HOST=smtp.example.edu
SMTP_PORT=465
SMTP_USERNAME=research@example.edu
SMTP_TLS=true
CONTACT_RECIPIENT_EMAIL=research@example.edu

DOCUMENT_ACCESS_TOKEN_TTL_HOURS=168
DOCUMENT_ANNOTATIONS_ENABLED=true
ABSTRACT_OCR_LANGUAGES=eng+fil

# Restic S3-compatible repository. Credentials belong in the server secret
# manager or environment used only by the backup systemd unit.
RESTIC_REPOSITORY=s3:https://s3.example.com/peas-production
RESTIC_PASSWORD_FILE=/etc/peas/secrets/restic_password
AWS_ACCESS_KEY_ID=replace-me
AWS_SECRET_ACCESS_KEY=replace-me
