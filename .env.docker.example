# Docker Compose reads variables from a root .env file automatically.
# Copy these values into .env if you want to override the defaults.

APP_PORT=18080
PUBLIC_APP_URL=http://localhost:18080
NEWSLETTER_TOKEN_SECRET=replace-with-at-least-32-random-bytes
NEWSLETTER_SEND_RATE_PER_MINUTE=20
OFFICE_REPLY_TO_EMAIL=
PGPASSWORD=change_this_local_postgres_password

# Optional when running `docker compose` directly. The provided start/update
# scripts automatically use the current Git commit as the release identifier.
# PEAS_RELEASE_ID=release-2026-07-31

# Optional override for approved-request download links.
DOCUMENT_ACCESS_TOKEN_TTL_HOURS=168

# Better Auth (generate the secret with: openssl rand -base64 32)
BETTER_AUTH_SECRET=change_this_generate_a_random_secret

# SMTP settings for password resets, contact mail, and document-request notifications.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_TLS=true
CONTACT_RECIPIENT_EMAIL=
