{
  "name": "paulinian-electronic-archiving-system",
  "private": true,
  "scripts": {
    "build:experience": "vite build --config experience-studio/vite.config.ts",
    "check:experience": "tsc -p experience-studio/tsconfig.json",
    "build:app-ui": "vite build --config app-ui/vite.admin.config.ts && vite build --config app-ui/vite.public.config.ts",
    "check:app-ui": "tsc -p app-ui/tsconfig.json",
    "build:ui": "npm run build:experience && npm run build:app-ui",
    "check:ui": "npm run check:experience && npm run check:app-ui",
    "check:deno": "cd Deno && deno task check",
    "test:deno": "cd Deno && deno task test",
    "test:classification-db": "cd Deno && deno task classification:db-test",
    "audit:classification": "cd Deno && deno task classification:audit:check",
    "test:experience": "playwright test -c experience-studio/playwright.config.ts",
    "test:public": "playwright test -c app-ui/playwright.public.config.ts",
    "test:admin": "playwright test -c app-ui/playwright.admin.config.ts",
    "test:reporting:ui": "playwright test -c app-ui/playwright.admin.config.ts --grep @reporting",
    "test:reporting-ui": "playwright test -c app-ui/playwright.admin.config.ts --grep @reporting",
    "test:reporting:unit": "cd Deno && deno test --allow-env --allow-read tests/operationalReporting_test.ts tests/reportingContract_test.ts tests/reportingExport_test.ts tests/topActivityReporting_test.ts",
    "test:reporting:db": "node scripts/run-reporting-db-test.mjs",
    "test:reporting:routes": "cd Deno && deno test --allow-env --allow-read tests/reportingRoutes_test.ts"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "postcss": "^8.5.25",
    "tailwindcss": "^4.1.3"
  },
  "dependencies": {
    "@fontsource-variable/inter": "^5.2.8",
    "@playwright/test": "^1.62.1",
    "@puckeditor/core": "^0.22.0",
    "@radix-ui/react-alert-dialog": "^1.1.18",
    "@radix-ui/react-avatar": "^1.2.1",
    "@radix-ui/react-checkbox": "^1.3.6",
    "@radix-ui/react-dialog": "^1.1.18",
    "@radix-ui/react-dropdown-menu": "^2.1.19",
    "@radix-ui/react-popover": "^1.1.18",
    "@radix-ui/react-select": "^2.3.2",
    "@radix-ui/react-separator": "^1.1.11",
    "@radix-ui/react-switch": "^1.3.2",
    "@radix-ui/react-tabs": "^1.1.16",
    "@radix-ui/react-tooltip": "^1.2.11",
    "@uppy/core": "^5.2.0",
    "@uppy/dashboard": "^5.1.1",
    "@uppy/xhr-upload": "^5.2.0",
    "@vitejs/plugin-react": "^6.0.3",
    "axe-core": "^4.12.1",
    "chart.js": "^4.5.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "gsap": "^3.15.0",
    "hls.js": "^1.6.16",
    "lucide-react": "^1.23.0",
    "motion": "^12.42.2",
    "ogl": "^1.0.11",
    "pdfjs-dist": "^6.2.108",
    "react": "^19.2.7",
    "react-dom": "^19.2.7",
    "react-icons": "^5.7.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "typescript": "^6.0.3",
    "vite": "^8.1.3",
    "zod": "^4.4.3"
  }
}
